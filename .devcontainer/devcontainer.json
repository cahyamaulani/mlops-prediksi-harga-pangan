{
  "name": "MLOps - Prediksi Harga Pangan",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "github.vscode-pull-request-github",
        "ms-azuretools.vscode-docker",
        "iterative.dvc"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "editor.rulers": [88]
      }
    }
  },

  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt && docker start minio || true",

  "remoteEnv": {
    "MLFLOW_TRACKING_URI": "http://localhost:5000"
  },

  "forwardPorts": [5000, 8000, 8501],
  "portsAttributes": {
    "5000": { "label": "MLflow UI" },
    "8000": { "label": "FastAPI" },
    "8501": { "label": "Streamlit Dashboard" }
  }
}